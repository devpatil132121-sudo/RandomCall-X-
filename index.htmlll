<!DOCTYPE html>
<html lang="mr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101827">
<title>RandomCall X</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;background:#0b1120;color:white;
  font-family:Arial,sans-serif
}
header{
  padding:24px 20px;
  background:linear-gradient(135deg,#172554,#4338ca);
  border-radius:0 0 22px 22px
}
header h1{margin:0;font-size:27px}
header p{color:#e0e7ff}
main{max-width:600px;margin:auto;padding:18px}
.card{
  background:#172033;border:1px solid #334155;
  border-radius:18px;padding:20px;margin-bottom:16px
}
h2{font-size:19px;margin-top:0}
label{display:block;margin-top:14px}
input,select{
  display:block;width:100%;padding:14px;margin-top:7px;
  background:#0b1120;color:white;border:1px solid #475569;
  border-radius:10px;font-size:16px
}
button{
  width:100%;padding:14px;margin-top:12px;
  background:#4f46e5;color:white;border:0;
  border-radius:10px;font-size:16px;font-weight:bold
}
button:disabled{opacity:.6}
.secondary{background:#334155}
.call{background:#15803d}
.small{font-size:13px;line-height:1.6;color:#cbd5e1}
#status{
  margin-top:14px;padding:12px;background:#0b1120;
  border-radius:10px;line-height:1.6;overflow-wrap:anywhere
}
</style>
</head>
<body>

<header>
  <h1>📞 RandomCall X</h1>
  <p>Business Internet Calling</p>
</header>

<main>

  <section class="card">
    <h2>🌐 Internet to Mobile Calling</h2>
    <p class="small">
      इंटरनेटद्वारे सामान्य मोबाईल नंबरवर कॉल करण्यासाठी
      अधिकृत Calling Service आवश्यक आहे.
    </p>

    <label for="phone">समोरच्या व्यक्तीचा मोबाईल नंबर</label>
    <input
      id="phone"
      type="tel"
      inputmode="tel"
      autocomplete="tel"
      placeholder="उदा. +919876543210"
      maxlength="16"
    >

    <label for="callerId">Caller ID</label>
    <select id="callerId">
      <option value="verified">सेवेकडून अधिकृत केलेला नंबर</option>
    </select>

    <button id="internetCall" class="call" type="button">
      🌐 Internet Call
    </button>

    <div id="status" role="status" aria-live="polite">
      स्थिती: Calling Service जोडलेली नाही.
    </div>
  </section>

  <section class="card">
    <h2>⚙️ Calling Service Configuration</h2>

    <p class="small">
      हा विभाग अधिकृत VoIP Backend जोडण्यासाठी आहे.
      API Secret किंवा Password सार्वजनिक वेबसाइटमध्ये टाकू नका.
    </p>

    <label for="backend">तुझ्या Backend चा HTTPS URL</label>
    <input
      id="backend"
      type="url"
      placeholder="https://your-server.example"
      autocomplete="url"
    >

    <button id="saveBackend" type="button">
      Backend URL सेट करा
    </button>

    <p class="small">
      फक्त URL सेट केल्याने कॉलिंग सुरू होत नाही.
      Backend मध्ये /api/calls endpoint आणि अधिकृत
      Calling Service जोडलेली असणे आवश्यक आहे.
    </p>
  </section>

  <section class="card">
    <h2>📋 कॉलिंगची माहिती</h2>
    <p class="small">
      • इंटरनेट कनेक्शन आवश्यक आहे.<br>
      • समोरच्या व्यक्तीकडे हे अॅप असण्याची गरज नाही.<br>
      • कॉलिंग सेवा आणि तिच्या दरांनुसार शुल्क लागू होऊ शकते.<br>
      • Caller ID साठी अधिकृत नंबरच वापरला जाईल.
    </p>
  </section>

</main>

<script>
(() => {
  "use strict";

  const phoneInput = document.getElementById("phone");
  const backendInput = document.getElementById("backend");
  const status = document.getElementById("status");
  const callButton = document.getElementById("internetCall");

  let backendUrl = "";

  function normalizePhone(value) {
    return value.trim().replace(/[\s()-]/g, "");
  }

  function validPhone(value) {
    return /^\+[1-9]\d{7,14}$/.test(value);
  }

  document.getElementById("saveBackend").addEventListener("click", () => {
    const value = backendInput.value.trim();

    try {
      const url = new URL(value);

      if (url.protocol !== "https:") {
        throw new Error("HTTPS आवश्यक आहे.");
      }

      backendUrl = url.origin;
      status.textContent =
        "Backend URL सेट झाला. आता कॉलिंग endpoint तपासला जाईल.";
    } catch (error) {
      backendUrl = "";
      status.textContent =
        "योग्य HTTPS Backend URL टाका.";
    }
  });

  callButton.addEventListener("click", async () => {
    const phone = normalizePhone(phoneInput.value);

    if (!validPhone(phone)) {
      status.textContent =
        "योग्य आंतरराष्ट्रीय फॉरमॅटमधील नंबर टाका. " +
        "उदा. +919876543210";
      return;
    }

    if (!backendUrl) {
      status.textContent =
        "Internet Calling सुरू नाही: आधी अधिकृत Calling " +
        "Service असलेला Backend जोडणे आवश्यक आहे.";
      return;
    }

    callButton.disabled = true;
    status.textContent = "Calling Service शी संपर्क साधत आहोत...";

    try {
      const response = await fetch(backendUrl + "/api/calls", {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({
          to: phone,
          callerIdMode: "verified"
        })
      });

      if (!response.ok) {
        throw new Error("Backend ने विनंती स्वीकारली नाही.");
      }

      const result = await response.json();

      if (result.status === "queued" || result.status === "initiated") {
        status.textContent =
          "कॉलिंग विनंती स्वीकारली गेली. " +
          "प्रत्यक्ष कॉल जोडला गेला आहे याची स्वतंत्र पुष्टी आवश्यक आहे.";
      } else {
        status.textContent =
          "Backend कडून प्रतिसाद मिळाला. कॉलची स्थिती: " +
          String(result.status || "अज्ञात");
      }
    } catch (error) {
      status.textContent =
        "कॉल सुरू झाला नाही. Backend, इंटरनेट कनेक्शन आणि " +
        "Calling Service चे सेटअप तपासा.";
    } finally {
      callButton.disabled = false;
    }
  });
})();
</script>

</body>
</html>
